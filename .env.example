# subsonic-proxy — environment overrides for docker-compose.yml
# Copy to `.env` and edit for your deployment. `.env` is gitignored.

# Where your music library lives on the host. The container mounts this at
# /music (read-write) so the YouTube fallback + Antra can write into it.
# Must be the same directory Navidrome and Antra already read from.
MUSIC_DIR=/srv/music

# Admin token for Antra's HTTP API. Get this from your Antra install
# (`ADMIN_KEY` in its environment). Required for the Downloader flow.
ANTRA_ADMIN_KEY=

# ─── Guest Request ───────────────────────────────────────────────
# Read-only Navidrome account the proxy uses to search on behalf of a
# scanned-in guest. Create a dedicated user in Navidrome (non-admin) so
# rotating this doesn't touch anyone else's login.
NAVIDROME_USER=
NAVIDROME_PASS=
